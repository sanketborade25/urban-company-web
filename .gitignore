/.sass-cache
/.cache
.tmp/
temp/
*.tmp

# Compiled output
*.js.map
*.css.map

# TypeScript transient files
*.tsbuildinfo

# Local env / secret config
.env
.env.local
.env.*.local

# Package manager lock optional (if not using)
